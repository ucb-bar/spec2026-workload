{
  "name" : "spec26-intspeed",
  "base" : "br-base.json",
  "workdir" : "..",
  "host-init" : "build-intspeed.sh ref",
  "overlay" : "speckle/build/overlay/intspeed/ref",
  "files" : [["marshal-configs/spec26-settings.sh", "/spec26-settings.sh"]],
  "rootfs-size" : "64GiB",
  "outputs" : ["/output"],
  "post_run_hook" : "handle-results.py -d ref -s intspeed",
  "jobs" : [
    {
      "name": "801.xz_s",
      "command": ". /spec26-settings.sh && ./intspeed.sh 801.xz_s --threads $SPEC26_INTSPEED_THREADS"
    },
    {
      "name": "807.ntest_s",
      "command": ". /spec26-settings.sh && ./intspeed.sh 807.ntest_s --threads $SPEC26_INTSPEED_THREADS"
    },
    {
      "name": "817.flac_s",
      "command": ". /spec26-settings.sh && ./intspeed.sh 817.flac_s --threads $SPEC26_INTSPEED_THREADS"
    },
    {
      "name": "821.gcc_s",
      "command": ". /spec26-settings.sh && ./intspeed.sh 821.gcc_s --threads $SPEC26_INTSPEED_THREADS"
    },
    {
      "name": "823.llvm_s",
      "command": ". /spec26-settings.sh && ./intspeed.sh 823.llvm_s --threads $SPEC26_INTSPEED_THREADS"
    },
    {
      "name": "827.cppcheck_s",
      "command": ". /spec26-settings.sh && ./intspeed.sh 827.cppcheck_s --threads $SPEC26_INTSPEED_THREADS"
    },
    {
      "name": "829.abc_s",
      "command": ". /spec26-settings.sh && ./intspeed.sh 829.abc_s --threads $SPEC26_INTSPEED_THREADS"
    },
    {
      "name": "834.vpr_s",
      "command": ". /spec26-settings.sh && ./intspeed.sh 834.vpr_s --threads $SPEC26_INTSPEED_THREADS"
    },
    {
      "name": "835.gem5_s",
      "command": ". /spec26-settings.sh && ./intspeed.sh 835.gem5_s --threads $SPEC26_INTSPEED_THREADS"
    },
    {
      "name": "838.diamond_s",
      "command": ". /spec26-settings.sh && ./intspeed.sh 838.diamond_s --threads $SPEC26_INTSPEED_THREADS"
    },
    {
      "name": "846.minizinc_s",
      "command": ". /spec26-settings.sh && ./intspeed.sh 846.minizinc_s --threads $SPEC26_INTSPEED_THREADS"
    },
    {
      "name": "853.ns3_s",
      "command": ". /spec26-settings.sh && ./intspeed.sh 853.ns3_s --threads $SPEC26_INTSPEED_THREADS"
    },
    {
      "name": "854.graph500_s",
      "command": ". /spec26-settings.sh && ./intspeed.sh 854.graph500_s --threads $SPEC26_INTSPEED_THREADS"
    }
  ]
}
